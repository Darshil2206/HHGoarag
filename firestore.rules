rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().size() == 2
        && data.email is string
        && data.email.size() <= 200
        && data.createdAt == request.time;
    }

    function isValidChat(data) {
      return data.keys().hasAll(['query', 'answer', 'language', 'timestamp'])
        && data.keys().size() == 4
        && data.query is string
        && data.query.size() <= 10000
        && data.answer is string
        && data.answer.size() <= 50000
        && data.language is string
        && data.language.size() <= 100
        && data.timestamp == request.time;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().email == request.auth.token.email;
      allow update: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([]) // immutable
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt;
      
      match /chats/{chatId} {
        allow read, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn()
          && request.auth.uid == userId
          && isValidId(chatId)
          && isValidChat(incoming())
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false; // chats are immutable
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
